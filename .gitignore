# ============================================================
# KAYA Bakery Monorepo — Root .gitignore
# ============================================================

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─── Agent internal state (tidak perlu masuk repo) ──────────
.agents/

# ─── OS ─────────────────────────────────────────────────────

.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Go (backend/) ──────────────────────────────────────────
backend/bin/
backend/*.exe
backend/tmp/
backend/vendor/

# ─── Local Go SDK & Module Cache (not committed) ─────────────
go/
go_sdk/

# ─── Node / Dashboard (frontend/) ──────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Docker ─────────────────────────────────────────────────
docker-data/
postgres-data/

# ─── Misc ────────────────────────────────────────────────────
*.log
*.pid
coverage/
.cache/

go_122/
go_122.zip
